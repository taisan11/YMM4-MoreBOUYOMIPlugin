<UserControl x:Class="MoreBOUYOMIVoicePlugin.MoreBOUYOMIVoiceSettingView"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:morebouyomivoiceplugin="clr-namespace:MoreBOUYOMIVoicePlugin" d:DataContext="{d:DesignInstance Type=morebouyomivoiceplugin:MoreBOUYOMIVoiceSettings}"
       mc:Ignorable="d"
       d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Expander Header="棒読みちゃんの設定" IsExpanded="True">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Plugin_HTTPAPICreateWavのポート番号"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WavPortNumber, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="話者一覧の取得・音声生成に使用します。既定値は50088です。"/>
                    <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                              Content="rawモードを使用する(YMM4側の音声記号変換を使用)"
                              IsChecked="{Binding UseRawMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,5,0,0" TextWrapping="Wrap"
                               Text="これはAquesTalk専用です。音量・音程の指定は無視されます。切り替え後はセリフの発音を再変換してください。"/>
                    <Label Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0"
                           Content="棒読みちゃんの実行ファイル"/>
                    <DockPanel Grid.Row="4" Grid.ColumnSpan="2">
                        <Button DockPanel.Dock="Right" Margin="5,0,0,0" Padding="10,2"
                                Content="参照..." Click="BrowseExecutable_Click"/>
                        <TextBox Text="{Binding BouyomiExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="棒読みちゃんの.exeを指定すると、話者一覧の取得・音声生成時に未起動なら起動します。"/>
                    </DockPanel>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
